# ---------------------------------------------------------------------------
# GPU4U payment service configuration. Copy to .env and edit. Never commit .env.
# ---------------------------------------------------------------------------

# simulated: runs with no credentials. Payments settle on an in-memory ledger, nothing reaches Hedera.
# testnet:   real settlement on Hedera testnet. Needs the accounts below.
PAYMENT_MODE=simulated

PORT=4021

# What payments are made in.
# hbar: converted from USD at the Hedera network exchange rate (default).
# usdc: an HTS token worth $1, so no exchange rate is needed and the quote is exact to the cent. The token must be
#       associated with the receiver (run `npm run associate`) and with the paying wallet, and the wallet must hold some
#       (testnet USDC faucet: https://faucet.circle.com , choose Hedera Testnet). Network fees are still paid in HBAR by
#       the facilitator fee payer.
PAYMENT_ASSET=hbar
# Only for PAYMENT_ASSET=usdc. Defaults to Circle's testnet USDC. Must have 6 decimals (checked at startup).
# USDC_TOKEN_ID=0.0.429274

# Shared secret between the web app server and this service. At least 16 characters.
# The web app must use the same value as PAYMENT_SERVICE_TOKEN.
SERVICE_TOKEN=change-me-to-a-long-random-string

# SQLite file holding quotes, approvals, payments and audit events.
DB_PATH=./data/payments.sqlite

# --- Spending policy, in USD (so limits do not drift with the HBAR price) -----
# Up to this amount the agent pays by itself.
AUTO_APPROVE_LIMIT_USD=0.50
# One wallet's total per rolling 24 hours. Passing it needs a human.
DAILY_LIMIT_USD=5
# Never paid, and no approval can override it.
HARD_CEILING_USD=25
# Everyone's total per 24 hours. Nothing proves who is asking, so this caps the agent's exposure.
GLOBAL_DAILY_LIMIT_USD=50

# click:  a person approves with a button. Convenient, but not proof of consent.
# wallet: approving requires a wallet signature over the exact payment terms (recommended).
APPROVAL_MODE=click
APPROVAL_TTL_SECONDS=300
QUOTE_TTL_SECONDS=600

# --- Hedera testnet (required when PAYMENT_MODE=testnet) -----------------------
# In testnet the USER'S CONNECTED WALLET pays and signs every payment. There is no agent key.
# The receiver gets the payments. It needs ONLY its account ID: receiving HBAR requires no key.
# HEDERA_RECEIVER_ID=0.0.xxxxxxx
# Optional. By default the fee payer below also posts the audit messages. Nothing is ever refunded.
# HEDERA_MERCHANT_PRIVATE_KEY=3030...
# Audit topic. Leave empty to create one with a submit key on first use.
# HEDERA_HCS_TOPIC_ID=0.0.xxxxxxx

# --- x402 facilitator ------------------------------------------------------------
# local (default in testnet): this service verifies and submits the wallet-signed transfer, with a
#   funded fee-payer account paying the network fee. The fee payer must differ from the merchant.
# external: a hosted facilitator (https://api.testnet.blocky402.com or https://x402.org/facilitator).
# FACILITATOR_MODE=local
# FACILITATOR_FEE_PAYER_ID=0.0.xxxxxxx
# FACILITATOR_FEE_PAYER_KEY=3030...
# FACILITATOR_URL=

# --- Operator check only (npm run live:check) ------------------------------------
# A funded testnet account used as a STAND-IN for the wallet. Never your HashPack key.
# HEDERA_TEST_PAYER_ID=0.0.xxxxxxx
# HEDERA_TEST_PAYER_KEY=3030...

# --- Development only: PAYMENT_MODE=simulated may use PAYER_MODE=agent|wallet ----------
# PAYER_MODE=agent

# --- Simulated mode only ---------------------------------------------------------
# SIM_USD_PER_HBAR=0.068
# SIM_STARTING_BALANCE_HBAR=1000
# SIM_STARTING_BALANCE_USDC=1000
