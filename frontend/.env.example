GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Optional: override the Aquanode public marketplace endpoint
# AQUANODE_MARKETPLACE_URL=https://server.aquanode.io/api/v1/marketplace

# --- Payments (the x402 payment service runs separately, see ../payment-engine) ---
# Where the web app's server reaches the payment service. The browser never calls it directly.
PAYMENT_SERVICE_URL=http://127.0.0.1:4021
# Must equal SERVICE_TOKEN in ../payment-engine/.env. At least 16 characters. Server only: no NEXT_PUBLIC prefix.
PAYMENT_SERVICE_TOKEN=change-me-to-a-long-random-string
# Optional: lets a real Hedera wallet (HashPack) connect and sign approvals.
# Get a free project ID at https://cloud.reown.com . Without it, an account ID can still be entered by hand.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
