# ---------------------------------------------------------------------------
# GPU4U: every variable for the combined deploy (web app + payment service).
# Set these in your host's dashboard. Never commit real values.
# Most values can be copied from payment-engine/.env and frontend/.env.local.
# ---------------------------------------------------------------------------

# Shared secret between the web app and the payment service. Set it once.
# Generate with: openssl rand -hex 24
SERVICE_TOKEN=

# --- Web app ---------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Needed at BUILD time (it is baked into the page). On Railway, set it as a normal variable.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Payment service -------------------------------------------------------
PAYMENT_MODE=testnet
APPROVAL_MODE=click

# In-memory store (history is lost on restart). Remove this line and attach a volume with
# DB_PATH=/data/payments.sqlite to keep history.
DB_PATH=:memory:

# Spending limits in USD
AUTO_APPROVE_LIMIT_USD=0.5
DAILY_LIMIT_USD=5
HARD_CEILING_USD=25
GLOBAL_DAILY_LIMIT_USD=50

# Hedera testnet accounts (copy from payment-engine/.env)
HEDERA_RECEIVER_ID=
HEDERA_MERCHANT_PRIVATE_KEY=
FACILITATOR_MODE=local
FACILITATOR_FEE_PAYER_ID=
FACILITATOR_FEE_PAYER_KEY=
# Pin the audit topic. If empty, a new topic is created on every start.
HEDERA_HCS_TOPIC_ID=

# --- Set by start.js, do not set --------------------------------------------
# PORT                 given by the host, used by the web app
# PAYMENT_SERVICE_URL  http://127.0.0.1:4021 (private, inside the container)
